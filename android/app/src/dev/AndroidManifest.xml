<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dev builds only (Nov 3, 2026): the background box watch
         (lib/services/box_watch_service.dart). While a box dose is due, a
         foreground service keeps the app awake so it can sync with the box
         every minute and a press of the box button is saved without the Sync
         button. The prod (Play) build has none of this: see
         src/prod/AndroidManifest.xml. A Play release with it would need the
         Play Console foreground-service declaration. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>

    <application>
        <!-- Name fixed by flutter_foreground_task. stopWithTask: swiping the
             app away ends the sync, so the service ends with it. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="true"
            android:exported="false"/>
    </application>
</manifest>
